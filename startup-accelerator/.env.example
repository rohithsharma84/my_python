# Required — the agents cannot run without these
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-5-mini

# Optional — enables live web research. Without it the system runs memory-only.
TAVILY_API_KEY=tvly-...

# Optional — LangSmith tracing. Without these the run still produces full local traces.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=Startup-Accelerator
